@{
    ViewData["Title"] = "Mùa vụ trái cây Việt Nam";
}

<style>
    .table-season th {
        background: linear-gradient(135deg, #28a745, #20c997) !important;
        color: white !important;
        vertical-align: middle;
        border: none;
    }
    .table-season {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }
    .group-header {
        background: linear-gradient(90deg, #e8f5e9, #c8e6c9) !important;
        color: #1b5e20 !important;
        font-weight: bold;
        letter-spacing: 0.5px;
    }
    .table-season tbody tr:hover {
        background-color: #f1f8e9 !important;
        transition: background-color 0.2s ease-in-out;
    }
    .fruit-icon {
        font-size: 1.2rem;
        display: inline-block;
        animation: popIn 0.3s ease-in-out;
    }
    @@keyframes popIn {
        0% { transform: scale(0.5); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

<div class="container my-4">
    <!-- Tiêu đề trang -->
    <div class="text-center mb-4">
        <h2 class="text-success fw-bold">🍎 Mùa vụ trái cây Việt Nam 🍊</h2>
        <p class="text-muted">Lịch thu hoạch tham khảo; thời điểm có thể thay đổi theo vùng trồng và giống cây.</p>
    </div>

    <div class="row">
        <!-- Thông tin vùng trồng -->
        <div class="col-md-3 mb-3">
            <div class="list-group shadow-sm rounded-3 overflow-hidden">
                <div class="list-group-item active bg-success border-success text-white fw-bold">🇻🇳 Việt Nam</div>
                <div class="list-group-item">
                    <strong>Miền Bắc</strong>
                    <div class="small text-muted">Vải thiều, nhãn, cam</div>
                </div>
                <div class="list-group-item">
                    <strong>Miền Trung</strong>
                    <div class="small text-muted">Thanh long, nho, dưa hấu</div>
                </div>
                <div class="list-group-item">
                    <strong>Miền Nam</strong>
                    <div class="small text-muted">Xoài, sầu riêng, chôm chôm</div>
                </div>
            </div>
        </div>

        <!-- Bảng thông tin mùa vụ 12 tháng -->
        <div class="col-md-9">
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle table-season bg-white">
                    <thead>
                        <tr>
                            <th style="width: 18%;">THÁNG<br>QUẢ</th>
                            <th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th>
                            <th>7</th><th>8</th><th>9</th><th>10</th><th>11</th><th>12</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="group-header text-start"><td colspan="13">🍇 MIỀN BẮC</td></tr>
                        <tr>
                            <td class="text-start fw-semibold">Vải thiều Bắc Giang</td>
                            <td></td><td></td><td></td><td></td><td><span class="fruit-icon">🍒</span></td><td><span class="fruit-icon">🍒</span></td><td><span class="fruit-icon">🍒</span></td><td></td><td></td><td></td><td></td><td></td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold">Nhãn lồng Hưng Yên</td>
                            <td></td><td></td><td></td><td></td><td></td><td></td><td><span class="fruit-icon">🍈</span></td><td><span class="fruit-icon">🍈</span></td><td><span class="fruit-icon">🍈</span></td><td></td><td></td><td></td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold">Cam Cao Phong</td>
                            <td><span class="fruit-icon">🍊</span></td><td><span class="fruit-icon">🍊</span></td><td><span class="fruit-icon">🍊</span></td><td></td><td></td><td></td><td></td><td></td><td><span class="fruit-icon">🍊</span></td><td><span class="fruit-icon">🍊</span></td><td><span class="fruit-icon">🍊</span></td><td><span class="fruit-icon">🍊</span></td>
                        </tr>

                        <tr class="group-header text-start"><td colspan="13">🍉 MIỀN TRUNG</td></tr>
                        <tr>
                            <td class="text-start fw-semibold">Thanh long Bình Thuận</td>
                            <td></td><td></td><td></td><td></td><td><span class="fruit-icon">🐉</span></td><td><span class="fruit-icon">🐉</span></td><td><span class="fruit-icon">🐉</span></td><td><span class="fruit-icon">🐉</span></td><td><span class="fruit-icon">🐉</span></td><td><span class="fruit-icon">🐉</span></td><td></td><td></td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold">Nho Ninh Thuận</td>
                            <td></td><td></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td><span class="fruit-icon">🍇</span></td><td></td><td></td>
                        </tr>

                        <tr class="group-header text-start"><td colspan="13">🥭 MIỀN NAM & TÂY NGUYÊN</td></tr>
                        <tr>
                            <td class="text-start fw-semibold">Xoài cát Hòa Lộc</td>
                            <td></td><td></td><td><span class="fruit-icon">🥭</span></td><td><span class="fruit-icon">🥭</span></td><td><span class="fruit-icon">🥭</span></td><td><span class="fruit-icon">🥭</span></td><td></td><td></td><td></td><td></td><td></td><td></td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold">Sầu riêng</td>
                            <td></td><td></td><td></td><td></td><td><span class="fruit-icon">🥥</span></td><td><span class="fruit-icon">🥥</span></td><td><span class="fruit-icon">🥥</span></td><td><span class="fruit-icon">🥥</span></td><td></td><td></td><td></td><td></td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold">Chôm chôm</td>
                            <td></td><td></td><td></td><td></td><td><span class="fruit-icon">🍒</span></td><td><span class="fruit-icon">🍒</span></td><td><span class="fruit-icon">🍒</span></td><td><span class="fruit-icon">🍒</span></td><td><span class="fruit-icon">🍒</span></td><td></td><td></td><td></td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold">Dâu tây Đà Lạt</td>
                            <td><span class="fruit-icon">🍓</span></td><td><span class="fruit-icon">🍓</span></td><td><span class="fruit-icon">🍓</span></td><td><span class="fruit-icon">🍓</span></td><td></td><td></td><td></td><td></td><td></td><td></td><td><span class="fruit-icon">🍓</span></td><td><span class="fruit-icon">🍓</span></td>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

